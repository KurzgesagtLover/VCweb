# PostgreSQL/PostGIS connection. Docker Compose defaults are shown for local development.
DATABASE_URL=postgresql://virtual_nation:virtual_nation_dev@localhost:5432/virtual_nation
# Generate with: openssl rand -base64 32 (minimum 32 characters).
BETTER_AUTH_SECRET=
APP_BASE_URL=http://localhost:3000

AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
MAP_HEX_EDGE_METERS=20000
APP_DEFAULT_LOCALE=ko
