{
  "name": "virtual-nation-mvp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts && tsx --env-file-if-exists=.env.local scripts/seed-phase-3-5.ts && tsx --env-file-if-exists=.env.local scripts/seed-phase-6.ts",
    "db:map": "tsx --env-file-if-exists=.env.local scripts/generate-global-map.ts",
    "db:map:raster": "tsx --env-file-if-exists=.env.local scripts/generate-16k-pixel-map.ts",
    "db:studio": "drizzle-kit studio",
    "health": "tsx --env-file-if-exists=.env.local scripts/healthcheck.ts",
    "perf:check": "tsx --env-file-if-exists=.env.local scripts/check-performance.ts",
    "verify:map-import": "tsx --env-file=.env.local scripts/verify-map-import.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "better-auth": "1.6.23",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "h3-js": "4.5.0",
    "maplibre-gl": "5.24.0",
    "next": "16.2.10",
    "postgres": "3.4.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.10",
    "prettier": "3.8.2",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
